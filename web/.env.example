# ---------------------------------------------------------------------------
# MakeItHappen — environment
#
# RULE (PLAN.md §7.6): the service-role key is NEVER prefixed NEXT_PUBLIC_.
# A CI test fails the build if that string appears in any client bundle.
# ---------------------------------------------------------------------------

# Public — safe for the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — Supabase
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only — messaging channel
#   console  : print to stdout (local dev, tests)
#   deeplink : render wa.me share links; no provider needed (demo / degraded mode)
#   twilio   : Twilio WhatsApp Business API, SMS fallback
MESSAGING_CHANNEL=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
# Public URL Twilio posts webhooks to. With a tunnel this is the tunnel URL,
# or signature validation fails for reasons that look like a code bug (§11.1).
TWILIO_WEBHOOK_URL=http://localhost:3000/api/webhooks/twilio

# Server-only — job runner. pg_cron (or any scheduler) calls
# POST /api/cron/run-jobs with `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=change-me

# Server-only — internal admin view (/admin). Comma-separated E.164 numbers.
ADMIN_PHONES=+972500000000

# Spend ceilings (§7.7). Messages, not currency — pricing varies by country.
MESSAGE_BUDGET_PER_TRIP=300
MESSAGE_BUDGET_PER_DAY=2000
MESSAGE_BUDGET_PER_MONTH=20000
